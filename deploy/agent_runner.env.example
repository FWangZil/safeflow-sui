# Server-only Agent Runner config. Do not commit the filled file.
PACKAGE_ID=0x...
SUI_NETWORK=testnet
PRODUCER_API_BASE_URL=http://producer-api:8787
PRODUCER_SIGNING_SECRET=replace-with-same-secret-as-producer-api
DEFAULT_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# Runtime guardrails.
SAFEFLOW_POLL_MS=3000
SAFEFLOW_MAX_AMOUNT_ATOMIC=0
SAFEFLOW_ALLOWED_RECIPIENTS=

# Walrus evidence upload. With degradation enabled, the runner records fallback:<sha256>
# if upload is unavailable during a demo.
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
WALRUS_DEGRADE_ON_UPLOAD_FAILURE=true
