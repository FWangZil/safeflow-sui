# Server-only Producer API config. Do not commit the filled file.
PACKAGE_ID=0x...
SUI_NETWORK=testnet
PRODUCER_SIGNING_SECRET=replace-with-same-secret-as-agent-runner
SPONSOR_SECRET_KEY=replace-with-sponsor-sui-private-key

# The public frontend URL deployed on Cloudflare Pages/Workers.
APP_URL=https://your-safeflow-frontend.pages.dev

DEFAULT_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
DEFAULT_CURRENCY_SYMBOL=USDC
DEFAULT_CURRENCY_DECIMALS=6
NATIVE_GASLESS_COIN_TYPES=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# Set fee bps to 0 unless you have a valid stablecoin fee recipient ready.
SPONSOR_MAX_GAS_BUDGET=10000000
SPONSOR_FEE_BPS=0
SPONSOR_MIN_FEE_ATOMIC=0
SPONSOR_FEE_RECIPIENT=

# Optional but recommended for reconcile/admin operations.
PRODUCER_ADMIN_TOKEN=replace-with-admin-token

# Demo seed inputs used by producer-api-seed-demo.
DEMO_MERCHANT_ID=merchant_demo
DEMO_MERCHANT_NAME=Demo Merchant
DEMO_MERCHANT_API_KEY=sf_demo_local_dev
DEMO_PAYOUT_ADDRESS=0x...
DEMO_AGENT_ADDRESS=0x...
DEMO_WALLET_ID=0x...
DEMO_SESSION_CAP_ID=0x...
