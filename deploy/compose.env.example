# Used with: docker compose --env-file deploy/compose.env ...
POSTGRES_DB=safeflow
POSTGRES_USER=safeflow
POSTGRES_PASSWORD=change-this-postgres-password
PRODUCER_API_HOST_PORT=8787

# For GHCR images built by .github/workflows/docker-images.yml.
# Replace owner/repo and tag with your repository and selected tag, for example main or a short SHA.
SAFEFLOW_IMAGE_TAG=main
SAFEFLOW_PRODUCER_API_IMAGE=ghcr.io/owner/repo-producer-api:${SAFEFLOW_IMAGE_TAG}
SAFEFLOW_AGENT_RUNNER_IMAGE=ghcr.io/owner/repo-agent-runner:${SAFEFLOW_IMAGE_TAG}
